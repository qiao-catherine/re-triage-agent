# =============================================================================
# AC Deal Triage — environment variables (single source of truth)
# =============================================================================
#
# Copy this file to `.env` and fill it in. Both processes read from it:
#
#   • Backend  — langgraph.json points at "../.env"
#   • Frontend — frontend/next.config.mjs loads "../.env" via dotenv
#
# Frontend security:
#   Only NEXT_PUBLIC_* values are shipped to the browser bundle. Everything
#   else (in particular LANGSMITH_API_KEY and DEPLOYMENT_URL) stays on the
#   server. The frontend's /api/lg/[...path] route proxies LangGraph calls
#   from the browser to the deployment, injecting the API key server-side
#   so it never enters the client bundle.
# =============================================================================


# ---- Required: model provider ---------------------------------------------
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # optional; unset = default OpenAI

OPENAI_MODEL=openai:gpt-4.1-mini
OPENAI_MAX_RETRIES=3


# ---- Required: LangSmith ---------------------------------------------------
# Used by the backend for tracing + feedback writes, and by the frontend's
# server-side proxy to authenticate against the deployment. NEVER prefixed
# with NEXT_PUBLIC_ — this key stays on the server.

LANGSMITH_API_KEY=lsv2-...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ac-deal-triage


# ---- Deployment URL (server-only) ------------------------------------------
# Where the frontend's proxy forwards LangGraph requests to. NOT
# NEXT_PUBLIC_ — the browser never sees this URL directly; it talks to its
# own origin at /api/lg.

DEPLOYMENT_URL=http://localhost:2024


# ---- Frontend public env (safe to ship in the bundle) ----------------------

NEXT_PUBLIC_GRAPH_ID=deal_triage
NEXT_PUBLIC_INBOX_NAME=Deal Triage
